# registry 专属（非敏感 dev 默认值）。共享坐标（Nacos 等）见 .env.common。
# 真敏感密钥写 .env.registry.secret（已 gitignore）。

# 数据库（patra-net 服务名 postgres + 容器内端口 5432）
REGISTRY_DB_URL=jdbc:postgresql://postgres:5432/patra_registry
REGISTRY_DB_USERNAME=postgres
REGISTRY_DB_PASSWORD=123456

# Redis（patra-net 服务名 redis:6379）
REGISTRY_REDIS_URL=redis://redis:6379
