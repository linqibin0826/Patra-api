# ============================================================
# Patra 应用容器 - 共享基建坐标（非敏感 dev 默认值，随仓库提交）
# ============================================================
# 安全：这里只放内网 dev 默认值（人尽皆知、服务仅在 tailscale 内网暴露，公网打不到端口）。
# 真敏感密钥（外部数据源 API key / token 等）一律写进对应 .env.<svc>.secret
# （已 gitignore，绝不进公开仓库），compose 的 env_file 会自动叠加加载。
# 坐标用 patra-net 容器服务名 + 容器内端口（非宿主映射端口）。

# Spring profile：容器统一用 container（专为环境变量注入设计）。
# 注：container 非「生产环境」，只是「容器化部署」这一运行形态；prod 预留给未来真正的云生产。
SPRING_PROFILES_ACTIVE=container

# 日志目录（镜像内 appuser 可写）
PATRA_LOG_DIR=/app/logs

# --- Nacos 服务发现（patra-net 服务名 nacos:8848，gRPC 不经 tailscale）---
NACOS_HOST=nacos
NACOS_PORT=8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# --- MinIO 对象存储（patra-net 服务名 minio:9000，内网 dev 默认凭据）---
# 注：minioadmin/minioadmin123 即 docker-compose.storage.yaml 的 dev 默认，已是公开 dev 凭据
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# --- RocketMQ NameServer（patra-net 服务名 rocketmq-namesrv:9876）---
ROCKETMQ_NAMESRV=rocketmq-namesrv:9876

# --- xxl-job admin（patra-net 服务名 + 容器内端口 8080 + context /xxl-job-admin）---
# 宿主映射是 7070→8080；容器间互访用内部端口 8080
XXL_JOB_ADMIN_ADDRESSES=http://xxl-job-admin:8080/xxl-job-admin
