# Patra 应用容器环境变量模板 —— 复制为 .env.apps 使用
# 仅放非敏感 dev 默认值；真敏感密钥见 .env.apps.secret.example
SPRING_PROFILES_ACTIVE=prod

REGISTRY_DB_URL=jdbc:postgresql://postgres:5432/patra_registry
REGISTRY_DB_USERNAME=postgres
REGISTRY_DB_PASSWORD=changeme

REGISTRY_REDIS_URL=redis://redis:6379

NACOS_HOST=nacos
NACOS_PORT=8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=changeme
