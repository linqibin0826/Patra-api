# Patra 应用容器 - 非敏感 dev 默认值（随仓库提交）
# ============================================================
# 安全：这里只放内网 dev 默认值（人尽皆知、服务仅在 tailscale 内网暴露，公网打不到）。
# 真敏感密钥（OpenAI / PubMed / Crossref API key、PAT 等）一律写进 .env.apps.secret
# （已 gitignore，绝不进仓库），compose 的 env_file 会自动叠加加载。

# Spring profile：容器统一用 prod（专为环境变量注入设计）
SPRING_PROFILES_ACTIVE=prod

# --- registry: 数据库（容器内 patra-net 服务名 postgres + 容器内端口 5432）---
REGISTRY_DB_URL=jdbc:postgresql://postgres:5432/patra_registry
REGISTRY_DB_USERNAME=postgres
REGISTRY_DB_PASSWORD=123456

# --- registry: Redis（容器内 redis:6379）---
REGISTRY_REDIS_URL=redis://redis:6379

# --- Nacos 服务发现（容器内 nacos:8848，同 patra-net，gRPC 不经 tailscale）---
NACOS_HOST=nacos
NACOS_PORT=8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
