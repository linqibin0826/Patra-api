# catalog 专属（非敏感 dev 默认值）。共享坐标（Nacos / MinIO endpoint+凭据 / xxl-job admin）见 .env.common。
# 真敏感密钥写 .env.catalog.secret（已 gitignore）。

# 主业务库（patra-net 服务名 postgres:5432）
CATALOG_DB_URL=jdbc:postgresql://postgres:5432/patra_catalog
CATALOG_DB_USERNAME=postgres
CATALOG_DB_PASSWORD=123456

# Redis
CATALOG_REDIS_URL=redis://redis:6379

# Spring Batch 独立库
BATCH_DB_URL=jdbc:postgresql://postgres:5432/patra_batch
BATCH_DB_USERNAME=postgres
BATCH_DB_PASSWORD=123456

# MinIO bucket（endpoint/凭据见 .env.common）
MINIO_BUCKET=patra-catalog-cache

# xxl-job executor 日志目录（admin 地址见 .env.common；executor IP 留空，patra-net 内自动探测）
XXL_JOB_EXECUTOR_LOG_PATH=/app/logs/xxl-job/patra-catalog

# 🔴 外部数据源凭据【不在此文件】（公开仓库安全红线）：
#    SCOPUS_API_KEY / PROXY_AUTH_KEY / PROXY_AUTH_PWD —— 需要时写入 .env.catalog.secret（已 gitignore）。
#    catalog application.yml 对这些有默认值，缺失不阻塞启动（仅运行时调用外部源会受影响）。
